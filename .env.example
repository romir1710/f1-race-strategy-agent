# .env.example — Template for environment variables
# Copy this file to .env and fill in your real API keys.
# NEVER commit your actual .env file — it is listed in .gitignore.

# ---------------------------------------------------------------------------
# Google AI Studio API Key
# Get yours free at: https://aistudio.google.com/app/apikey
# Used by LangChain to call Google Gemini 2.5 Flash
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-ai-studio-key-here

# ---------------------------------------------------------------------------
# Telegram Bot Token
# Get yours from @BotFather on Telegram:
#   1. Open Telegram and search for @BotFather
#   2. Send /newbot and follow the prompts
#   3. Copy the token it gives you here
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# ---------------------------------------------------------------------------
# LangSmith API Key (for tracing and observability)
# Sign up free at: https://smith.langchain.com
# Then go to Settings > API Keys > Create API Key
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=your-langsmith-key-here

# Enable LangSmith tracing (set to true to send traces to smith.langchain.com)
LANGSMITH_TRACING=true

# The project name that traces will appear under in LangSmith
LANGSMITH_PROJECT=f1-race-strategy-agent
